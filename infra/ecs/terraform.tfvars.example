# terraform.tfvars로 복사해 채운다 (terraform.tfvars는 커밋하지 않는다).
# 여기에는 비밀값을 넣지 않는다. 비밀값은 SSM Parameter Store에 직접 넣는다 (docs/ECS_MIGRATION.md).

api_domain       = "api.example.com"          # 지금 서버 .env의 DOMAIN
budget_email     = "you@example.com"
google_client_id = "1234567890-abc.apps.googleusercontent.com"

# 지금 서버 .env에 있는 비밀이 아닌 값을 옮긴다
app_env = {
  CCI_TEMPLATE_URL         = "https://cci-templates-111122223333.s3.ap-northeast-2.amazonaws.com/customer-readonly-role.yaml"
  CCI_CALLBACK_TOPIC_ARN   = "arn:aws:sns:ap-northeast-2:111122223333:cloudcost-insight-connections"
  CCI_CALLBACK_QUEUE_URL   = "https://sqs.ap-northeast-2.amazonaws.com/111122223333/cloudcost-insight-callbacks"
  CCI_COLLECTION_QUEUE_URL = "https://sqs.ap-northeast-2.amazonaws.com/111122223333/cloudcost-insight-collection"
}

# Grafana Cloud (비우면 Alloy 사이드카 없이 띄운다)
grafana_prom_url  = ""
grafana_prom_user = ""

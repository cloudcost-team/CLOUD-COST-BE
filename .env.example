# 복사해서 값만 채운다: cp .env.example .env  (.env는 커밋하지 않는다)
# 앱은 .env를 자동으로 읽지 않는다. 실행 전에 export 하거나 IDE 실행 설정에 넣는다:
#   set -a; source .env; set +a; ./gradlew bootRun

APP_ENV=local
AUTH_MODE=dev
DEV_OWNER_ID=local-dev-user

# Google 로그인 (docs/decisions/004). 클라이언트 ID는 공개 값. JWT_SECRET은 비밀(32바이트 이상): openssl rand -base64 48
GOOGLE_CLIENT_ID=
JWT_SECRET=

# PostgreSQL (docker compose up -d db)
DB_URL=jdbc:postgresql://localhost:5432/cci
DB_USERNAME=cci
DB_PASSWORD=cci

# 우리 계정 백엔드 Role ARN = 고객 Trust Policy의 Principal (docs/AWS_SETUP_GUIDE.md 2절)
# 아래는 예시 값이다. 실제 값으로 바꾸지 않으면 고객 Role 생성 시 Invalid principal 오류가 난다.
CCI_BACKEND_ROLE_ARN=arn:aws:iam::111122223333:role/CloudCostInsightBackendRole

# 빠른 생성 링크 + 스택 신호 (docs/AWS_SETUP_GUIDE.md 2절, 관리자가 1번 준비)
CCI_TEMPLATE_URL=https://cci-templates-111122223333.s3.ap-northeast-2.amazonaws.com/customer-readonly-role.yaml
CCI_CALLBACK_TOPIC_ARN=arn:aws:sns:ap-northeast-2:111122223333:cloudcost-insight-connections
CCI_CALLBACK_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/111122223333/cloudcost-insight-connections

# 백엔드가 쓸 AWS 자격증명 프로필 (~/.aws/config). 키 값을 여기에 넣지 않는다.
AWS_PROFILE=cci-backend

# 캐시 기간 (기본값: 인스턴스 10분, CloudWatch 1시간, 소급 90일)
# CCI_INSTANCE_TTL=10m
# CCI_USAGE_TTL=1h
# CCI_USAGE_BACKFILL=90d
